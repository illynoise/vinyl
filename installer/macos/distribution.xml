<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Base Jase Plugins - Vinyl Studio</title>
    <organization>com.basejaseplugins</organization>
    <background file="background.png" alignment="bottomleft" scaling="none" mime-type="image/png"/>
    <background-darkAqua file="background.png" alignment="bottomleft" scaling="none" mime-type="image/png"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline><line choice="default"><line choice="com.basejaseplugins.vinylstudio"/></line></choices-outline>
    <choice id="default"/>
    <choice id="com.basejaseplugins.vinylstudio" visible="false"><pkg-ref id="com.basejaseplugins.vinylstudio"/></choice>
    <pkg-ref id="com.basejaseplugins.vinylstudio" onConclusion="none">VinylStudio-component.pkg</pkg-ref>
</installer-gui-script>
